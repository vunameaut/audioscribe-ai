# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Mô hình Gemini mặc định (gemini-2.5-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Mô hình Faster-Whisper Offline mặc định (small, medium, base)
WHISPER_MODEL=small

# Cổng máy chủ
HOST=127.0.0.1
PORT=8000
